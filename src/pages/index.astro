---
import Base from '../layouts/Base.astro';
import StatesMap from '../components/StatesMap.astro';
import Horizon from '../components/Horizon.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { services, groups, byGroup } from '../data/services';

const faqs = [
  { q: 'What does A&H Lease Services do?', a: 'We build and maintain oilfield locations: lease roads, pads, fencing and gates, right-of-way mowing, weed spraying, location signs, pipeline markers, pressure washing, jobsite cleanup, spill cleanup and general dirt work.' },
  { q: 'Where do you work?', a: 'We are based in Longview, Texas and work across East Texas, Louisiana, Arkansas and Oklahoma.' },
  { q: 'Can I get a price without a site visit?', a: 'Yes, for a planning number. The estimators on this site give a price range for lease roads, pads, mowing and weed spraying from the job size. A firm bid comes after we see the location.' },
  { q: 'Do you take emergency calls?', a: 'Yes. Emergencies are answered 24 hours a day, 7 days a week at 903-424-1607. Normal office hours are Monday 10:30 to 4:00 and Tuesday through Friday 9:00 to 4:00.' },
];
const schema = [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }];
const num = (i: number) => String(i + 1).padStart(2, '0');
---
<Base intro preloadImage="/video/jobsite-poster.jpg" title="A&H Lease Services | Oilfield Lease Services, Longview TX" description="Oilfield lease services from Longview, Texas: lease roads, pad construction, right-of-way mowing, weed spraying, fencing, signs and spill cleanup across TX, LA, AR and OK." schema={schema}>
  <section class="hero band">
    <!-- Real footage behind the top of the page: three free stock clips of equipment at work (Pexels),
         turned black and white, tinted green and joined into one loop. A dark green cover sits over it
         so the words stay easy to read. Visitors with "reduce motion" on see a still picture instead. -->
    <video class="hero__vid" autoplay muted loop playsinline preload="metadata" poster="/video/jobsite-poster.jpg" aria-hidden="true" tabindex="-1" disablepictureinpicture><source src="/video/jobsite.mp4" type="video/mp4" /></video>
    <div class="hero__cover" aria-hidden="true"></div>
    <div class="wrap hero__in">
      <div class="hero__copy">
        <p class="eyebrow">Longview, Texas · Oilfield lease services</p>
        <h1>The road in, the pad, and everything that keeps a location working.</h1>
        <p class="lede">A&amp;H builds and maintains oilfield locations across Texas, Louisiana, Arkansas and Oklahoma. One crew with its own equipment, and one number to call.</p>
        <div class="btn-row">
          <a class="btn btn--gold" href="/request-a-bid/">Request a bid</a>
          <a class="btn btn--line" href="/estimators/">Price a job now</a>
        </div>
      </div>
      <!-- Laid out like a lease sign at a location entrance: plain facts, nothing claimed that is not confirmed. -->
      <aside class="sign" aria-label="A&H at a glance">
        <p class="sign__top">A&amp;H Lease Services</p>
        <dl>
          <div><dt>Home base</dt><dd>{site.city}, Texas</dd></div>
          <div><dt>Coverage</dt><dd>TX · LA · AR · OK</dd></div>
          <div><dt>Emergency</dt><dd>24/7 call-out</dd></div>
          <div><dt>Office hours</dt><dd>{site.hours.map((h) => <span class="sign__hrs">{h.label}</span>)}</dd></div>
          <div><dt>Dispatch</dt><dd><a href={site.phoneHref}>{site.phone}</a></dd></div>
        </dl>
      </aside>
    </div>
    <!-- Under the sign card: the drawn machines at work, with A&H clouds and the dozer pushing words. -->
    <Horizon fun />
  </section>
  <script is:inline>
    (function () {
      var v = document.querySelector('.hero__vid'); if (!v) return;
      // Reduce motion: no moving video, just the still picture.
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { v.removeAttribute('autoplay'); v.pause(); return; }
      // Stop the video when it is scrolled out of view, so it does not use battery or data for nothing.
      if ('IntersectionObserver' in window) new IntersectionObserver(function (e) { if (e[0].isIntersecting) { var p = v.play(); if (p && p.catch) p.catch(function () {}); } else v.pause(); }, { threshold: 0.05 }).observe(v);
    })();
  </script>

  <section class="section">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">What we do</p>
        <h2>Everything a location needs, in three kinds of work.</h2>
        <p class="lede">Operators call us to build a location, to keep it up, and when something goes wrong on it.</p>
      </div>
      <div class="ledger">
        {groups.map((g) => (
          <div class="ledger__group">
            <div class="ledger__head"><h3>{g.name}</h3><p>{g.line}</p></div>
            <ul>
              {byGroup(g.key).map((s) => (
                <li><a href={`/services/${s.slug}/`}><span class="ledger__n">{num(services.indexOf(s))}</span><span class="ledger__name">{s.nav}</span><span class="ledger__short">{s.short}</span><span class="ledger__go" aria-hidden="true">→</span></a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap split split--even">
      <div>
        <p class="eyebrow">How we work</p>
        <h2>Built for the people who answer for the location.</h2>
        <p class="lede">Company men, production foremen and landmen need the same things from a lease contractor. This is how we run every job.</p>
      </div>
      <ol class="steps">
        <li><h3>A person answers</h3><p>You talk to the people who will be on the job. Tell us the county, the lease and what it needs.</p></li>
        <li><h3>We look before we price</h3><p>For anything beyond a simple cut or a small repair, we walk the location and bid it from what is there.</p></li>
        <li><h3>Our crew, our equipment</h3><p>The work is done by our own hands with our own equipment. If a job calls for a machine we do not have on hand, we bring one in.</p></li>
        <li><h3>Left in order</h3><p>Gates closed, ruts dressed, trash hauled off. The landowner should have nothing to call you about.</p></li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap pricing">
      <div>
        <p class="eyebrow">Estimators</p>
        <h2>See a price range before you ever pick up the phone.</h2>
        <p class="lede">Enter the size of a lease road, a pad, a right-of-way or a spray job and get a range on the spot. No name or email asked first.</p>
        <a class="btn btn--green" href="/estimators/">Open the estimators</a>
      </div>
      <ul class="pricing__list">
        <li><a href="/estimators/#road"><span>Lease road</span><em>By length, width and rock depth</em></a></li>
        <li><a href="/estimators/#pad"><span>Pad</span><em>By length, width and rock depth</em></a></li>
        <li><a href="/estimators/#mowing"><span>Right-of-way mowing</span><em>By the mile or the acre</em></a></li>
        <li><a href="/estimators/#spraying"><span>Weed spraying</span><em>By the mile or the acre</em></a></li>
      </ul>
    </div>
  </section>

  <section class="section band area">
    <div class="wrap split split--even">
      <div>
        <p class="eyebrow">Service area</p>
        <h2>Out of Longview, across four states.</h2>
        <p class="lede">East Texas is home. We travel for work in Louisiana, Arkansas and Oklahoma, and price mobilization honestly so there are no surprises.</p>
        <a class="textlink" href="/service-areas/">See where we work</a>
      </div>
      <StatesMap />
    </div>
    <Horizon />
  </section>

  <!-- Jobsite Games teaser (Colton, Nov 17, 2026: the games should be easy for anyone to find). -->
  <section class="section section--alt games-teaser">
    <div class="wrap games-teaser__in">
      <div>
        <p class="eyebrow">Jobsite Games</p>
        <h2>Think you can run the iron?</h2>
        <p class="lede">Five free games: push dirt with a dozer, dig a trench, mow right-of-way, spray weeds and haul rock. No sign-up. Just play.</p>
      </div>
      <a class="btn btn--gold" href="/games/">Play the games</a>
    </div>
  </section>

  <section class="section">
    <div class="wrap narrow">
      <p class="eyebrow">Common questions</p>
      <h2>Before you call.</h2>
      <div class="faq">{faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
    </div>
  </section>

  <CtaBand scene={false} />
</Base>

<style>
  .games-teaser { padding: clamp(40px, 5vw, 64px) 0; }
  .games-teaser__in { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 18px 40px; }
  .games-teaser__in h2 { margin-bottom: 0.3em; }
  .games-teaser__in .lede { margin: 0; }
  .hero { position: relative; isolation: isolate; padding: clamp(54px, 7.5vw, 110px) 0 0; overflow: hidden; }
  .hero__in { padding-bottom: clamp(22px, 3vw, 40px); }
  .hero__vid { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 42% 50%; z-index: -2; background: #073a2c; }
  /* The dark green cover over the footage: heaviest behind the words, lighter toward the right. */
  .hero__cover { position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(7, 58, 44, 0.5) 0%, rgba(7, 58, 44, 0) 22%, rgba(7, 58, 44, 0) 72%, rgba(7, 58, 44, 0.85) 100%), linear-gradient(90deg, rgba(7, 58, 44, 0.84) 0%, rgba(7, 58, 44, 0.7) 46%, rgba(7, 58, 44, 0.48) 100%); }
  /* Phones and tablets: the top section is tall and narrow, so stretching the footage to fill it showed only
     the middle quarter of the picture (very zoomed in). Here the footage sits across the top instead, behind
     the headline, showing about 60% of the picture, and fades out into plain green below. */
  @media (max-width: 939px) {
    .hero__vid { inset: 0 0 auto 0; height: auto; aspect-ratio: 10 / 9; max-height: 100%; -webkit-mask-image: linear-gradient(#000 62%, transparent 100%); mask-image: linear-gradient(#000 62%, transparent 100%); background: transparent; }
    .hero__cover { background: linear-gradient(180deg, rgba(7, 58, 44, 0.74) 0%, rgba(7, 58, 44, 0.66) 34%, rgba(7, 58, 44, 0.82) 62%, rgba(7, 58, 44, 0.9) 100%); }
  }
  /* the words and the sign ease in once when the page opens */
  .hero__copy > *, .sign { animation: rise 0.9s var(--ease) both; }
  .hero__copy > :nth-child(2) { animation-delay: 0.08s; } .hero__copy > :nth-child(3) { animation-delay: 0.16s; } .hero__copy > :nth-child(4) { animation-delay: 0.24s; } .sign { animation-delay: 0.3s; }
  @keyframes rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .hero__copy > *, .sign { animation: none; } }
  .hero__in { display: grid; gap: clamp(34px, 5vw, 72px); align-items: center; }
  .hero h1 { max-width: 17ch; }
  .hero .lede { margin-bottom: 30px; }
  .sign { color: var(--ink); --muted: #36413b; --border: rgba(5, 42, 32, 0.2); border-radius: var(--radius-lg); border: 3px solid var(--green-ink); outline: 2px solid var(--gold); outline-offset: -9px; padding: 28px 30px 24px; box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35); background: var(--card); }
  .sign__top { font-family: var(--font-display); font-stretch: 120%; font-weight: 750; font-size: 1.25rem; letter-spacing: -0.02em; color: var(--green); margin: 0 0 14px; padding-bottom: 14px; border-bottom: 2px solid var(--green); text-transform: uppercase; }
  .sign dl { margin: 0; display: grid; }
  .sign dl > div { display: grid; grid-template-columns: 104px 1fr; gap: 14px; padding: 10px 0; border-bottom: 1px solid var(--border); }
  .sign dl > div:last-child { border-bottom: 0; padding-bottom: 0; }
  .sign dt { font-family: var(--font-display); font-stretch: 112%; font-size: 0.7rem; letter-spacing: 0.15em; text-transform: uppercase; font-weight: 600; color: var(--muted); padding-top: 4px; }
  .sign dd { margin: 0; font-weight: 600; line-height: 1.35; }
  .sign a { color: var(--green-deep); text-underline-offset: 3px; }
  .sign__hrs { display: block; }
  @media (min-width: 940px) { .hero__in { grid-template-columns: 1.25fr 0.75fr; } }

  .head { max-width: 760px; margin-bottom: clamp(28px, 4vw, 48px); }
  .ledger { display: grid; gap: clamp(26px, 3.5vw, 44px); }
  .ledger__group { display: grid; gap: 14px 40px; border-top: 2px solid var(--green); padding-top: 20px; }
  .ledger__head h3 { font-size: clamp(1.4rem, 2.2vw, 1.8rem); margin-bottom: 6px; }
  .ledger__head p { color: var(--text-2); margin: 0; max-width: 30ch; }
  .ledger ul { list-style: none; margin: 0; padding: 0; }
  .ledger li a { display: grid; grid-template-columns: 34px minmax(150px, 0.55fr) 1fr 20px; gap: 14px; align-items: baseline; padding: 15px 0; text-decoration: none; border-bottom: 1px solid var(--border); }
  .ledger li:last-child a { border-bottom: 0; }
  .ledger__n { font-family: var(--font-display); font-size: 0.76rem; letter-spacing: 0.1em; color: var(--muted); font-variant-numeric: tabular-nums; }
  .ledger__name { font-family: var(--font-display); font-stretch: 112%; font-weight: 650; font-size: 1.08rem; color: var(--green); letter-spacing: -0.01em; }
  .ledger__short { color: var(--text-2); font-size: 0.98rem; }
  .ledger__go { color: var(--green); transition: transform 0.2s var(--ease); }
  .ledger li a:hover .ledger__go { transform: translateX(4px); }
  .ledger li a:hover .ledger__name { text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--gold-dark); }
  @media (min-width: 900px) { .ledger__group { grid-template-columns: 0.42fr 1fr; } }
  /* phones: names only, so twelve services stay a short list instead of a long column */
  @media (max-width: 640px) { .ledger li a { grid-template-columns: 30px 1fr 18px; padding: 13px 0; } .ledger__short { display: none; } }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; counter-reset: step; }
  .steps li { counter-increment: step; position: relative; padding: 20px 0 20px 62px; border-top: 1px solid var(--border-strong); }
  .steps li:last-child { border-bottom: 1px solid var(--border-strong); }
  .steps li::before { content: counter(step, decimal-leading-zero); position: absolute; left: 0; top: 22px; font-family: var(--font-display); font-stretch: 116%; font-weight: 700; font-size: 1.15rem; color: var(--green); }
  .steps h3 { margin-bottom: 4px; }
  .steps p { margin: 0; color: var(--text-2); }

  .pricing { display: grid; gap: clamp(28px, 5vw, 72px); align-items: center; }
  .pricing .lede { margin-bottom: 26px; }
  .pricing__list { list-style: none; margin: 0; padding: 0; background: var(--surface); border: 1px solid var(--border); border-top: 3px solid var(--green); border-radius: var(--radius-lg); }
  .pricing__list a { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; flex-wrap: wrap; padding: 19px 24px; text-decoration: none; border-bottom: 1px solid var(--border); }
  .pricing__list li:last-child a { border-bottom: 0; }
  .pricing__list span { font-family: var(--font-display); font-stretch: 112%; font-weight: 650; font-size: 1.1rem; color: var(--green); }
  .pricing__list em { font-style: normal; color: var(--text-2); font-size: 0.95rem; }
  .pricing__list a:hover span { text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--gold-dark); }
  @media (min-width: 900px) { .pricing { grid-template-columns: 1fr 1fr; } }

  .area { padding-bottom: 0; overflow: hidden; }
  .area > .wrap { padding-bottom: clamp(28px, 4vw, 52px); }
  .area .textlink { color: #fff; }
  .area .smap { max-width: 520px; justify-self: center; width: 100%; }
</style>
