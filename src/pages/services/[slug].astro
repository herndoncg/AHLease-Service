---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site } from '../../data/site';
import { services, groups, byGroup, type Service } from '../../data/services';

export function getStaticPaths() { return services.map((s) => ({ params: { slug: s.slug }, props: { s } })); }
const { s } = Astro.props as { s: Service };
const group = groups.find((g) => g.key === s.group)!;
const related = byGroup(s.group).filter((o) => o.slug !== s.slug).slice(0, 4);
const url = `${site.url}/services/${s.slug}`;
const schema = [
  { '@context': 'https://schema.org', '@type': 'Service', name: s.name, description: s.description, url, serviceType: s.name, provider: { '@id': `${site.url}/#business` }, areaServed: site.statesServed.map((n) => ({ '@type': 'State', name: n })) },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: s.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: site.url }, { '@type': 'ListItem', position: 2, name: 'Services', item: `${site.url}/services` }, { '@type': 'ListItem', position: 3, name: s.name, item: url }] },
];
---
<Base title={s.title} description={s.description} schema={schema}>
  <section class="pagehead band plat">
    <div class="wrap">
      <ol class="crumbs"><li><a href="/">Home</a></li><li><a href="/services">Services</a></li><li>{s.nav}</li></ol>
      <p class="eyebrow">{group.name}</p>
      <h1>{s.name}</h1>
      <p class="lede">{s.short}</p>
      <div class="btn-row">
        <a class="btn btn--gold" href={`/request-a-bid?service=${encodeURIComponent(s.name)}`}>Request a bid</a>
        {s.estimator ? <a class="btn btn--line" href={`/estimators#${s.estimator}`}>See a price range</a> : <a class="btn btn--line" href={site.phoneHref}>Call {site.phone}</a>}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <p class="intro">{s.intro}</p>
        <h2>What is included</h2>
        <ul class="checks">{s.scope.map((x) => <li>{x}</li>)}</ul>
      </div>
      <aside class="panel">
        <h3>When to call</h3>
        <p>{s.when}</p>
        <p class="side__tel"><a href={site.phoneHref}>{site.phone}</a></p>
        <p class="muted side__note">Based in {site.city}, Texas. Working in {site.statesServed.join(', ').replace(/, ([^,]*)$/, ' and $1')}.</p>
      </aside>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap narrow">
      <p class="eyebrow">Questions</p>
      <h2>{s.nav}: what operators ask</h2>
      <div class="faq">{s.faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Related work</p>
      <ul class="rel">{related.map((o) => <li><a href={`/services/${o.slug}`}><span>{o.nav}</span><em>{o.short}</em></a></li>)}</ul>
    </div>
  </section>
  <CtaBand title={`Need ${s.nav.toLowerCase()} priced?`} />
</Base>

<style>
  .intro { font-size: clamp(1.1rem, 1.5vw, 1.26rem); color: var(--text-2); max-width: 60ch; margin-bottom: 1.8em; }
  .side__tel { margin: 0 0 12px; }
  .side__tel a { font-family: var(--font-display); font-stretch: 116%; font-weight: 700; font-size: 1.6rem; letter-spacing: -0.02em; color: var(--green); text-decoration: none; }
  .side__note { font-size: 0.92rem; margin: 0; }
  .rel { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--green); }
  .rel a { display: grid; gap: 4px 30px; padding: 17px 0; text-decoration: none; border-bottom: 1px solid var(--border); }
  .rel span { font-family: var(--font-display); font-stretch: 112%; font-weight: 650; font-size: 1.08rem; color: var(--green); }
  .rel em { font-style: normal; color: var(--text-2); }
  .rel a:hover span { text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--gold-dark); }
  @media (min-width: 760px) { .rel a { grid-template-columns: 0.4fr 1fr; align-items: baseline; } }
</style>
