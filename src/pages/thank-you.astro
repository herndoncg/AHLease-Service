---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="Request received" description="Your bid request reached A&H Lease Services." noindex>
  <section class="pagehead band plat">
    <div class="wrap">
      <h1>We have your request.</h1>
      <p class="lede">A person will read it and call you back. If it cannot wait, call <a href={site.phoneHref} style="color:#fff">{site.phone}</a> now.</p>
      <div class="btn-row"><a class="btn btn--gold" href="/">Back to the home page</a><a class="btn btn--line" href="/services">See all services</a></div>
    </div>
  </section>
  <script is:inline>try { sessionStorage.removeItem('ah_estimate'); sessionStorage.removeItem('ah_estimate_service'); } catch (e) {}</script>
</Base>
