---
import { site } from '../data/site';
interface Props { title?: string; line?: string }
const { title = 'Have a location that needs work?', line = 'Tell us where it is and what it needs. You will hear back from a person, not a call center.' } = Astro.props;
---
<section class="cta band plat">
  <div class="wrap cta__in">
    <div>
      <h2>{title}</h2>
      <p class="lede">{line}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn--gold" href="/request-a-bid">Request a bid</a>
      <a class="btn btn--line" href={site.phoneHref}>Call {site.phone}</a>
    </div>
  </div>
</section>

<style>
  .cta { padding: clamp(48px, 6.5vw, 84px) 0; }
  .cta__in { display: grid; gap: 26px; align-items: center; }
  .cta h2 { margin-bottom: 0.35em; }
  .cta .lede { margin: 0; }
  @media (min-width: 900px) { .cta__in { grid-template-columns: 1fr auto; } }
</style>
