---
import { site } from '../data/site';
import { groups, byGroup } from '../data/services';
const year = new Date().getFullYear();
---
<footer class="ftr band">
  <div class="wrap">
    <div class="ftr__top">
      <div class="ftr__id">
        <p class="ftr__name">A&amp;H Lease Services</p>
        <p class="ftr__where">{site.city}, Texas<br />Serving Texas, Louisiana, Arkansas and Oklahoma</p>
        <p class="ftr__where">Emergencies: 24/7<br />{site.hours.map((h, i) => <>{i > 0 && <br />}{h.label}</>)}</p>
        <p class="ftr__contact">
          <a href={site.phoneHref}>{site.phone}</a>
          {site.phone2 && <a href={site.phone2Href}>{site.phone2}</a>}
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </div>
      <!-- On phones each list folds shut, so the footer is not a long column. -->
      {groups.map((g) => (
        <details class="ftr__col" open>
          <summary>{g.name}</summary>
          <ul>{byGroup(g.key).map((s) => <li><a href={`/services/${s.slug}`}>{s.nav}</a></li>)}</ul>
        </details>
      ))}
      <details class="ftr__col" open>
        <summary>Company</summary>
        <ul>
          <li><a href="/about">About</a></li>
          <li><a href="/service-areas">Service area</a></li>
          <li><a href="/estimators">Estimators</a></li>
          <li><a href="/blog">Field notes</a></li>
          <li><a href="/request-a-bid">Request a bid</a></li>
          <li><a href={site.sister.url} rel="noopener">{site.sister.name}: paving</a></li>
        </ul>
      </details>
    </div>
    <blockquote class="ftr__verse">
      <p>“{site.verse.text}”</p>
      <cite>{site.verse.ref}</cite>
    </blockquote>
    <div class="ftr__base">
      <p>© {year} A&amp;H Lease Services. All rights reserved.</p>
      <p><a href="/privacy">Privacy</a></p>
    </div>
  </div>
</footer>
<script is:inline>
  // Footer lists start open on computers and folded on phones.
  (function () { if (window.matchMedia('(max-width: 759px)').matches) document.querySelectorAll('.ftr__col').forEach(function (d) { d.open = false; }); })();
</script>

<style>
  .ftr { border-top: 2px solid var(--gold); padding: clamp(44px, 6vw, 72px) 0 28px; font-size: 0.95rem; }
  .ftr a { text-decoration: none; color: var(--text-2); }
  .ftr a:hover { color: #fff; text-decoration: underline; text-underline-offset: 3px; }
  .ftr__top { display: grid; gap: 34px 40px; grid-template-columns: 1.5fr repeat(4, 1fr); }
  .ftr__name { font-family: var(--font-display); font-stretch: 116%; font-weight: 700; font-size: 1.3rem; letter-spacing: -0.02em; margin: 0 0 10px; color: #fff; }
  .ftr__where { color: var(--muted); margin: 0 0 16px; }
  .ftr__contact { display: grid; gap: 6px; margin: 0; }
  .ftr__contact a { color: #fff; font-weight: 600; }
  .ftr__col summary { list-style: none; font-family: var(--font-display); font-stretch: 112%; font-weight: 600; font-size: 0.76rem; letter-spacing: 0.16em; text-transform: uppercase; color: #fff; margin-bottom: 14px; cursor: default; }
  .ftr__col summary::-webkit-details-marker { display: none; }
  .ftr__col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 9px; }
  .ftr__verse { margin: clamp(36px, 5vw, 56px) 0 0; padding: 26px 0 0; border-top: 1px solid var(--border); max-width: 62ch; }
  .ftr__verse p { font-family: var(--font-display); font-stretch: 105%; font-size: 1.1rem; font-weight: 500; line-height: 1.45; margin: 0 0 8px; color: #fff; }
  .ftr__verse cite { font-style: normal; font-size: 0.8rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .ftr__base { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-top: 34px; padding-top: 20px; border-top: 1px solid var(--border); color: var(--muted); font-size: 0.86rem; }
  .ftr__base p { margin: 0; }
  @media (max-width: 1000px) { .ftr__top { grid-template-columns: 1fr 1fr; } .ftr__id { grid-column: 1 / -1; } }
  @media (max-width: 759px) {
    .ftr__top { grid-template-columns: 1fr; gap: 0; }
    .ftr__id { margin-bottom: 22px; }
    .ftr__col { border-top: 1px solid var(--border); }
    .ftr__col summary { cursor: pointer; margin: 0; padding: 17px 28px 17px 0; position: relative; }
    .ftr__col summary::after { content: '+'; position: absolute; right: 2px; top: 11px; font-size: 1.4rem; font-weight: 400; letter-spacing: 0; }
    .ftr__col[open] summary::after { content: '\2212'; }
    .ftr__col ul { padding-bottom: 18px; }
  }
  /* leave room for the fixed Call / Request a bid bar on phones */
  @media (max-width: 860px) { .ftr { padding-bottom: calc(84px + env(safe-area-inset-bottom)); } }
</style>
