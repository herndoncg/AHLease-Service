---
// The working horizon along the bottom of the home page hero: a far-off jobsite in silhouette.
// Colton asked for this on Nov 16, 2026: black and white with a green hue, far away, nothing detailed,
// with some depth. Far things are lighter and smaller, near things darker and larger.
// It is drawn shapes, not photos. When real job video exists, it can replace this strip.
// People who have "reduce motion" turned on see the same scene standing still.

// A steady pretend-random number maker, so the tree line is the same on every build.
let seed = 7; const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
// Far tree line (East Texas pines), as one jagged shape sitting on the horizon.
let trees = 'M0,152'; for (let x = 0; x <= 1600; x += 9 + rnd() * 9) { const h = 8 + rnd() * 16; trees += ` L${x.toFixed(0)},${(150 - h * 0.35).toFixed(0)} L${(x + 4).toFixed(0)},${(150 - h).toFixed(0)} L${(x + 8).toFixed(0)},${(150 - h * 0.3).toFixed(0)}`; } trees += ' L1600,152 Z';
// The fence: posts run from close (big, far apart) to far (small, close together).
const N = 12, K = 0.34, far = 1 - 1 / (1 + K * (N - 1));
const posts = Array.from({ length: N }, (_, i) => { const t = (1 - 1 / (1 + K * i)) / far; return { i, x: 270 + 350 * t, y: 238 - 58 * t, h: 50 * (1 - t) ** 1.5 + 9, w: 4 * (1 - t) + 1.4 }; });
const STEP = 1.5; // seconds between posts going up
---
<div class="hz" aria-hidden="true">
  <svg viewBox="0 0 1600 240" preserveAspectRatio="xMidYMax slice" focusable="false">
    <defs>
      <linearGradient id="hz-glow" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#8fc4ae" stop-opacity="0" /><stop offset="1" stop-color="#8fc4ae" stop-opacity="0.36" /></linearGradient>
    </defs>
    <rect width="1600" height="152" fill="url(#hz-glow)" />
    <path class="hz__ridge" d="M0,152 L0,120 Q120,96 260,112 T520,104 T800,118 T1060,98 T1320,114 T1600,102 L1600,152 Z" />
    <path class="hz__trees" d={trees} />
    <rect class="hz__far" y="150" width="1600" height="90" />

    <!-- far off: two pumpjacks nodding on the horizon -->
    {[{ x: 1330, s: 0.8, d: 0 }, { x: 170, s: 0.62, d: -2.3 }].map((p) => (
      <g class="hz__farthing" transform={`translate(${p.x},152) scale(${p.s})`}>
        <path d="M-9,0 L0,-30 L9,0 M-5,-13 H5 M18,0 V-9 M-22,0 H24" fill="none" stroke-width="2.6" />
        <g transform="translate(0,-30)"><g class="hz__beam" style={`animation-delay:${p.d}s`}><path d="M-27,0 H20" fill="none" stroke-width="3.2" /><path d="M-27,-7 Q-35,0 -27,8 Z" stroke="none" /><path d="M20,0 L18,22" fill="none" stroke-width="1.6" /><path d="M-30,6 V26" fill="none" stroke-width="1.2" /></g></g>
      </g>
    ))}

    <!-- far off: a dump truck crossing on the lease road, with dust behind it -->
    <g class="hz__truck"><g transform="translate(0,152) scale(0.62)">
      <circle class="hz__dust" cx="34" cy="-6" r="7" /><circle class="hz__dust" cx="46" cy="-9" r="9" style="animation-delay:-0.7s" /><circle class="hz__dust" cx="60" cy="-11" r="11" style="animation-delay:-1.4s" />
      <path class="hz__farfill" d="M-26,-6 V-19 H-17 L-13,-24 H-9 V-9 L-7,-26 H27 L25,-9 H25 V-6 Z" /><circle class="hz__farfill" cx="-17" cy="-4" r="4.4" /><circle class="hz__farfill" cx="10" cy="-4" r="4.4" /><circle class="hz__farfill" cx="20" cy="-4" r="4.4" />
    </g></g>

    <path class="hz__mid" d="M0,240 L0,174 Q200,166 420,172 T860,170 T1240,174 T1600,168 L1600,240 Z" />

    <!-- middle distance: an excavator digging, with its spoil pile -->
    <path class="hz__midfill" d="M905,173 Q925,150 948,158 Q966,150 985,173 Z" />
    <g class="hz__midfill" transform="translate(1040,173) scale(1.1)">
      <rect x="-30" y="-11" width="62" height="11" rx="5.5" />
      <path d="M-22,-11 V-27 H-6 V-42 H12 V-27 H30 V-11 Z" />
      <rect class="hz__glass" x="-3" y="-39" width="12" height="9" />
      <g transform="translate(-8,-27)"><g class="hz__boom">
        <path d="M0,0 L-24,-31 L-54,-33" fill="none" stroke-width="6.5" stroke-linejoin="round" stroke-linecap="round" />
        <g transform="translate(-54,-33)"><g class="hz__stick">
          <path d="M0,0 L-9,38" fill="none" stroke-width="4.6" stroke-linecap="round" />
          <g transform="translate(-9,38)"><path class="hz__bucket" d="M3,-4 L5,5 L-2,13 L-13,9 Q-10,-1 3,-4 Z" stroke="none" /></g>
        </g></g>
      </g></g>
    </g>

    <path class="hz__near" d="M0,240 L0,204 Q260,192 520,198 T1040,196 T1600,202 L1600,240 Z" />

    <!-- close: the fence going up, post by post, then the wire -->
    <g class="hz__fence">
      {posts.map((p) => <rect class="hz__post" x={(p.x - p.w / 2).toFixed(1)} y={(p.y - p.h).toFixed(1)} width={p.w.toFixed(1)} height={p.h.toFixed(1)} style={`animation-delay:${(p.i * STEP).toFixed(2)}s`} />)}
      {posts.slice(1).map((p) => { const a = posts[p.i - 1]; return [0.12, 0.42, 0.72].map((f) => <line class="hz__wire" x1={a.x.toFixed(1)} y1={(a.y - a.h * (1 - f)).toFixed(1)} x2={p.x.toFixed(1)} y2={(p.y - p.h * (1 - f)).toFixed(1)} style={`animation-delay:${(p.i * STEP + 0.5).toFixed(2)}s`} />); })}
    </g>

    <!-- close: a dozer pushing dirt, then backing up for the next pass -->
    <path class="hz__nearfill" d="M915,197 Q932,176 952,183 Q968,176 984,197 Z" />
    <g class="hz__dozer"><g class="hz__nearfill" transform="translate(720,197) scale(1.3)">
      <circle class="hz__dust" cx="40" cy="-10" r="7" /><circle class="hz__dust" cx="46" cy="-16" r="9" style="animation-delay:-1.1s" />
      <rect x="-30" y="-13" width="56" height="13" rx="6.5" />
      <path d="M-25,-13 V-37 H-7 V-25 H21 V-13 Z" /><rect x="11" y="-34" width="2.4" height="10" />
      <rect class="hz__glass" x="-21" y="-33" width="10" height="9" />
      <path d="M-6,-6 L29,-5" fill="none" stroke-width="3" /><path d="M29,-23 Q36,-12 32,0 L28,0 Q32,-11 26,-23 Z" />
      <path class="hz__push" d="M32,0 Q44,-17 60,0 Z" />
    </g></g>
  </svg>
</div>

<style>
  .hz { height: clamp(150px, 17vw, 236px); margin-bottom: -1px; overflow: hidden; }
  .hz svg { width: 100%; height: 100%; display: block; }
  /* far = lighter and hazier, near = darker. That is what gives the strip its depth. */
  .hz__ridge { fill: #1c6551; opacity: 0.55; }
  .hz__trees { fill: #0f4b3b; }
  .hz__far { fill: #093a2d; }
  .hz__farthing { stroke: #05261d; fill: #05261d; }
  .hz__farfill { fill: #05261d; }
  .hz__mid { fill: #062c22; }
  .hz__midfill { fill: #031d16; stroke: #031d16; }
  .hz__near { fill: #041f18; }
  .hz__nearfill { fill: #021410; stroke: #021410; }
  .hz__glass { fill: #2f7d66; stroke: none; }
  .hz__post { fill: #021410; transform-box: fill-box; transform-origin: 50% 100%; animation: hz-post 24s linear infinite backwards; }
  .hz__wire { stroke: #021410; stroke-width: 1; animation: hz-wire 24s linear infinite backwards; }
  .hz__dust { fill: #9cc9b6; stroke: none; opacity: 0; transform-box: fill-box; transform-origin: center; animation: hz-dust 2.2s ease-out infinite; }
  .hz__beam { animation: hz-nod 5.2s ease-in-out infinite; }
  .hz__truck { animation: hz-truck 46s linear infinite; }
  .hz__boom { animation: hz-boom 9s ease-in-out infinite; }
  .hz__stick { animation: hz-stick 9s ease-in-out infinite; }
  .hz__bucket { animation: hz-bucket 9s ease-in-out infinite; }
  .hz__dozer { animation: hz-dozer 15s ease-in-out infinite; }
  .hz__push { transform-box: fill-box; transform-origin: 0% 100%; animation: hz-push 15s ease-in-out infinite; }
  .hz__dozer .hz__dust { animation-name: hz-dust-doze; animation-duration: 2.6s; }

  @keyframes hz-nod { 0%, 100% { transform: rotate(-9deg); } 50% { transform: rotate(9deg); } }
  @keyframes hz-truck { from { transform: translateX(1700px); } to { transform: translateX(-140px); } }
  @keyframes hz-dust { 0% { opacity: 0.3; transform: scale(0.5); } 100% { opacity: 0; transform: translate(14px, -10px) scale(1.5); } }
  @keyframes hz-dust-doze { 0% { opacity: 0.22; transform: scale(0.5); } 100% { opacity: 0; transform: translate(-8px, -14px) scale(1.5); } }
  /* dig: reach out and down, curl in, lift, dump, back out */
  @keyframes hz-boom { 0%, 100% { transform: rotate(2deg); } 22%, 42% { transform: rotate(-11deg); } 66%, 84% { transform: rotate(9deg); } }
  @keyframes hz-stick { 0%, 100% { transform: rotate(14deg); } 22% { transform: rotate(22deg); } 42%, 66% { transform: rotate(-24deg); } 84% { transform: rotate(20deg); } }
  @keyframes hz-bucket { 0%, 22%, 100% { transform: rotate(0deg); } 42%, 66% { transform: rotate(-38deg); } 84% { transform: rotate(18deg); } }
  /* push forward, pause, back up, pause */
  @keyframes hz-dozer { 0%, 4% { transform: translateX(0); } 52%, 58% { transform: translateX(150px); } 94%, 100% { transform: translateX(0); } }
  @keyframes hz-push { 0%, 4% { transform: scale(0.3); opacity: 1; } 52% { transform: scale(1); opacity: 1; } 58%, 100% { transform: scale(0.3); opacity: 0; } }
  @keyframes hz-post { 0% { transform: scaleY(0); opacity: 1; } 3% { transform: scaleY(1); } 88% { transform: scaleY(1); opacity: 1; } 93%, 100% { transform: scaleY(1); opacity: 0; } }
  @keyframes hz-wire { 0% { opacity: 0; } 3%, 88% { opacity: 0.9; } 93%, 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .hz * { animation: none !important; } .hz__dust { opacity: 0; } }
</style>
