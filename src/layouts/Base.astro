---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/public-sans';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { services } from '../data/services';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  /** Home page only: the short opening reveal, shown once per visit. */
  intro?: boolean;
  /** An image to start loading first (the biggest thing on screen). */
  preloadImage?: string;
}

const { title, description: rawDescription, type = 'website', schema = [], noindex = false, intro = false, preloadImage } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
// Every page's address ends with a slash (that is how the host serves them), so the address given to
// Google matches the sitemap and never points at a redirect.
const canonical = new URL(path === '/' ? '/' : path + '/', site.url).href;
// Google shows about 60 characters of a title and 155 of a description.
const withName = `${title} | A&H Lease Services`;
const fullTitle = title.includes('A&H') ? title : withName.length < 60 ? withName : `${title} | A&H`;
const clip = (s: string, n: number) => (s.length <= n ? s : s.slice(0, s.lastIndexOf(' ', n - 1)).replace(/[,;:.\s]+$/, '') + '.');
const description = clip(rawDescription, 158);
const ogImage = new URL('/og-default.png', site.url).href;
const onBidPage = path.startsWith('/request-a-bid');

const business: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  '@id': `${site.url}/#business`,
  name: site.name,
  description: 'Oilfield lease services contractor based in Longview, Texas, serving Texas, Louisiana, Arkansas and Oklahoma: lease road and pad construction, right-of-way mowing, weed spraying, fencing, location signs, pipeline markers, spill cleanup and dirt work.',
  url: site.url,
  telephone: site.phoneSchema,
  email: site.email,
  image: ogImage,
  address: { '@type': 'PostalAddress', addressLocality: site.city, addressRegion: site.state, addressCountry: 'US', ...(site.postalCode ? { postalCode: site.postalCode } : {}) },
  areaServed: site.statesServed.map((s) => ({ '@type': 'State', name: s })),
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday'], opens: site.hours[0].open, closes: site.hours[0].close },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: site.hours[1].open, closes: site.hours[1].close },
  ],
  hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Oilfield lease services', itemListElement: services.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.name, url: `${site.url}/services/${s.slug}/` } })) },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- 0.9 = phones show the site slightly zoomed out, with roomier margins (Colton's preference, same as the CGH site). -->
    <meta name="viewport" content="width=device-width, initial-scale=0.9" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#073a2c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

    <script is:inline>
      // Remembers where a visitor came from (Google, Facebook, direct...) the first time they land,
      // so the bid form can pass it along with the lead. Kept only in this browser tab.
      (function () {
        try {
          if (sessionStorage.getItem('ah_src')) return;
          var q = new URLSearchParams(location.search), ref = document.referrer, host = '';
          try { host = ref ? new URL(ref).hostname.replace(/^www\./, '') : ''; } catch (e) {}
          var tag = (q.get('utm_source') || '').toLowerCase(), src = 'Direct';
          if (q.get('gclid') || /google/.test(tag)) src = 'Google Ads';
          else if (q.get('fbclid') || /facebook|fb|instagram|meta/.test(tag)) src = 'Facebook';
          else if (tag) src = tag;
          else if (/google\./.test(host)) src = 'Google';
          else if (/facebook\.|fb\.|instagram\./.test(host)) src = 'Facebook';
          else if (/bing\.|duckduckgo\.|yahoo\./.test(host)) src = 'Other search';
          else if (host && host !== location.hostname) src = host;
          sessionStorage.setItem('ah_src', src);
          sessionStorage.setItem('ah_landing', location.pathname);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    {intro && (
      <Fragment>
        <!-- The opening screen: the name, a gold line drawn across like a grade line, then it fades away to
             show the equipment video behind the home page.
             About 2 seconds, once per visit. It never blocks a tap, and it is skipped for reduce-motion. -->
        <script is:inline>
          try { if (!sessionStorage.getItem('ah_intro') && !matchMedia('(prefers-reduced-motion: reduce)').matches) { sessionStorage.setItem('ah_intro', '1'); document.documentElement.classList.add('ah-intro'); } } catch (e) {}
        </script>
        <div class="intro" aria-hidden="true"><div class="intro__in"><span class="intro__ah">A&amp;H</span><span class="intro__line"></span><span class="intro__ls">Lease Services</span></div></div>
      </Fragment>
    )}
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <nav class="callbar" aria-label="Quick contact">
      <a href={site.phoneHref} class="callbar__call">Call</a>
      {!onBidPage && <a href="/request-a-bid/" class="callbar__bid">Request a bid</a>}
    </nav>

    <style is:global>
      .intro { display: none; }
      .ah-intro .intro { display: grid; place-items: center; position: fixed; inset: 0; z-index: 300; background: #073a2c; pointer-events: none; animation: intro-fade 1.1s ease-in-out 1.45s both; }
      .intro__in { display: grid; justify-items: center; gap: 16px; color: #fff; }
      .intro__ah { font-family: var(--font-display); font-stretch: 122%; font-weight: 750; font-size: clamp(3.4rem, 12vw, 6.5rem); letter-spacing: -0.04em; line-height: 1; animation: intro-in 0.6s ease-out both; }
      .intro__line { width: min(72vw, 420px); height: 3px; background: #d4a200; transform-origin: 0 50%; animation: intro-draw 0.9s cubic-bezier(0.6, 0, 0.2, 1) 0.2s both; }
      .intro__ls { font-family: var(--font-display); font-stretch: 112%; font-weight: 600; font-size: clamp(0.85rem, 2.6vw, 1.15rem); letter-spacing: 0.34em; text-transform: uppercase; animation: intro-in 0.6s ease-out 0.5s both; }
      @keyframes intro-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
      @keyframes intro-draw { from { transform: scaleX(0); } to { transform: scaleX(1); } }
      @keyframes intro-fade { to { opacity: 0; visibility: hidden; } }
    </style>
    <style>
      .callbar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 90; display: none; padding-bottom: env(safe-area-inset-bottom); background: var(--green-deep); box-shadow: 0 -6px 24px rgba(0, 0, 0, 0.2); border-top: 1px solid rgba(255, 255, 255, 0.12); }
      /* Solid green carries on below the bar, so the page never shows through under the buttons on
         phones that float their address bar over the page. */
      .callbar::after { content: ''; position: absolute; left: 0; right: 0; top: calc(100% - 1px); height: 240px; background: var(--green-deep); }
      .callbar a { display: flex; align-items: center; justify-content: center; min-height: 56px; flex: 1 1 0; font-family: var(--font-display); font-stretch: 112%; font-weight: 650; font-size: 1.02rem; letter-spacing: 0.02em; text-decoration: none; background: var(--green-deep); color: #fff; }
      .callbar .callbar__bid { flex-grow: 1.5; background: var(--gold); color: var(--ink); }
      @media (max-width: 860px) { .callbar { display: flex; } }
    </style>
  </body>
</html>
